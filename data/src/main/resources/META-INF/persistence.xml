<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="com.azkar.data.persistence" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Explicit entity registration (avoids "Unknown entity type" in multi-module builds) -->
        <class>com.azkar.data.entity.RemembranceEntity</class>
        <class>com.azkar.data.entity.RemembranceTranslationEntity</class>
        <class>com.azkar.data.entity.ExplanationTranslationEntity</class>
        <class>com.azkar.data.entity.TagEntity</class>
        <class>com.azkar.data.entity.FavoriteEntity</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- JDBC driver; the URL is supplied programmatically via DataSourceConfig -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>

            <!-- Dialect -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

            <!-- Schema managed outside Hibernate (Flyway) -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>

            <!-- Disable 2nd-level & query caches -->
            <property name="hibernate.cache.use_second_level_cache" value="false"/>
            <property name="hibernate.cache.use_query_cache" value="false"/>

            <!-- SQL logging -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>

            <!-- HikariCP pool via Hibernate's provider -->
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.minimumIdle" value="1"/>
            <property name="hibernate.hikari.maximumPoolSize" value="4"/>
            <property name="hibernate.hikari.idleTimeout" value="10000"/>
            <property name="hibernate.hikari.connectionTimeout" value="20000"/>
        </properties>
    </persistence-unit>
</persistence>
