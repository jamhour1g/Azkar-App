<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<fx:root fitToHeight="true" fitToWidth="true"
	focusTraversable="false" hbarPolicy="NEVER" styleClass="library-root"
	stylesheets="@../../styles/library/library_component.css"
	type="ScrollPane" vbarPolicy="AS_NEEDED"
	xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
	<VBox spacing="16.0" styleClass="library-content">
		<padding>
			<Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
		</padding>

		<HBox alignment="CENTER_LEFT" spacing="14.0"
			styleClass="library-header">
			<VBox spacing="4.0">
				<Text strokeType="OUTSIDE" strokeWidth="0.0"
					styleClass="library-title" text="%libraryTitle" />
				<Text strokeType="OUTSIDE" strokeWidth="0.0"
					styleClass="library-subtitle" text="%librarySubtitle" />
			</VBox>
			<Pane HBox.hgrow="ALWAYS" />
			<Button mnemonicParsing="false" styleClass="library-add-btn"
				text="%libraryAddNew">
				<graphic>
					<FontIcon iconLiteral="fas-plus" iconSize="12"
						styleClass="library-add-icon" />
				</graphic>
			</Button>
		</HBox>

		<HBox spacing="10.0" styleClass="library-toolbar">
			<HBox alignment="CENTER_LEFT" spacing="8.0"
				styleClass="library-search-wrap" HBox.hgrow="ALWAYS">
				<FontIcon iconLiteral="fas-search" iconSize="14"
					styleClass="library-search-icon" />
				<TextField HBox.hgrow="ALWAYS"
					promptText="%librarySearchPrompt" styleClass="library-search" />
			</HBox>
			<Button mnemonicParsing="false"
				styleClass="library-filter-chip, library-filter-chip-active"
				text="%libraryFilterMorning" />
			<Button mnemonicParsing="false"
				styleClass="library-filter-chip" text="%libraryFilterEvening" />
			<Button mnemonicParsing="false"
				styleClass="library-filter-chip" text="%libraryFilterTravel" />
		</HBox>

		<HBox alignment="CENTER_LEFT" spacing="6.0"
			styleClass="library-tabs">
			<Button mnemonicParsing="false" styleClass="library-tab"
				text="%libraryTabAll" />
			<Button mnemonicParsing="false"
				styleClass="library-tab, library-tab-active"
				text="%libraryTabMorning" />
			<Button mnemonicParsing="false" styleClass="library-tab"
				text="%libraryTabEvening" />
			<Button mnemonicParsing="false" styleClass="library-tab"
				text="%libraryTabFavorites" />
		</HBox>

		<FlowPane hgap="14.0" prefWrapLength="1150.0" vgap="14.0"
			styleClass="library-cards-flow">
			<VBox maxWidth="620.0" minWidth="320.0" prefWidth="548.0"
				spacing="12.0" styleClass="library-card">
				<HBox alignment="CENTER_LEFT" spacing="10.0">
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-card-badge" text="%libraryCategoryMorning" />
					<Pane HBox.hgrow="ALWAYS" />
					<HBox alignment="CENTER_RIGHT" spacing="4.0"
						styleClass="library-card-actions">
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="fas-volume-up" iconSize="12"
									styleClass="library-icon" />
							</graphic>
						</Button>
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="far-copy" iconSize="12"
									styleClass="library-icon" />
							</graphic>
						</Button>
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="far-star" iconSize="12"
									styleClass="library-icon" />
							</graphic>
						</Button>
					</HBox>
				</HBox>
				<Text strokeType="OUTSIDE" strokeWidth="0.0"
					styleClass="library-card-ar" text="%libraryAzkarMorningArabic"
					wrappingWidth="480.0" />
				<Text strokeType="OUTSIDE" strokeWidth="0.0"
					styleClass="library-card-en" text="%libraryAzkarMorningEnglish"
					wrappingWidth="480.0" />
				<Separator />
				<HBox alignment="CENTER_LEFT" spacing="8.0"
					styleClass="library-card-footer">
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-source-label" text="%librarySourceLabel" />
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-source-value" text="%librarySourceMorning" />
					<Pane HBox.hgrow="ALWAYS" />
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-count-badge" text="%libraryRepeatOne" />
				</HBox>
			</VBox>

			<VBox maxWidth="620.0" minWidth="320.0" prefWidth="548.0"
				spacing="12.0" styleClass="library-card">
				<HBox alignment="CENTER_LEFT" spacing="10.0">
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-card-badge" text="%libraryCategoryEvening" />
					<Pane HBox.hgrow="ALWAYS" />
					<HBox alignment="CENTER_RIGHT" spacing="4.0"
						styleClass="library-card-actions">
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="fas-volume-up" iconSize="12"
									styleClass="library-icon" />
							</graphic>
						</Button>
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="far-copy" iconSize="12"
									styleClass="library-icon" />
							</graphic>
						</Button>
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="fas-star" iconSize="12"
									styleClass="library-icon-favorite" />
							</graphic>
						</Button>
					</HBox>
				</HBox>
				<Text strokeType="OUTSIDE" strokeWidth="0.0"
					styleClass="library-card-ar" text="%libraryAzkarEveningArabic"
					wrappingWidth="480.0" />
				<Text strokeType="OUTSIDE" strokeWidth="0.0"
					styleClass="library-card-en" text="%libraryAzkarEveningEnglish"
					wrappingWidth="480.0" />
				<Separator />
				<HBox alignment="CENTER_LEFT" spacing="8.0"
					styleClass="library-card-footer">
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-source-label" text="%librarySourceLabel" />
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-source-value" text="%librarySourceEvening" />
					<Pane HBox.hgrow="ALWAYS" />
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-count-badge" text="%libraryRepeatOne" />
				</HBox>
			</VBox>

			<VBox maxWidth="620.0" minWidth="320.0" prefWidth="548.0"
				spacing="12.0" styleClass="library-card">
				<HBox alignment="CENTER_LEFT" spacing="10.0">
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-card-badge" text="%libraryCategoryTravel" />
					<Pane HBox.hgrow="ALWAYS" />
					<HBox alignment="CENTER_RIGHT" spacing="4.0"
						styleClass="library-card-actions">
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="fas-volume-up" iconSize="12"
									styleClass="library-icon" />
							</graphic>
						</Button>
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="far-copy" iconSize="12"
									styleClass="library-icon" />
							</graphic>
						</Button>
						<Button mnemonicParsing="false"
							styleClass="library-icon-btn">
							<graphic>
								<FontIcon iconLiteral="far-star" iconSize="12"
									styleClass="library-icon" />
							</graphic>
						</Button>
					</HBox>
				</HBox>
				<Text strokeType="OUTSIDE" strokeWidth="0.0"
					styleClass="library-card-ar" text="%libraryAzkarTravelArabic"
					wrappingWidth="480.0" />
				<Text strokeType="OUTSIDE" strokeWidth="0.0"
					styleClass="library-card-en" text="%libraryAzkarTravelEnglish"
					wrappingWidth="480.0" />
				<Separator />
				<HBox alignment="CENTER_LEFT" spacing="8.0"
					styleClass="library-card-footer">
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-source-label" text="%librarySourceLabel" />
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-source-value" text="%librarySourceTravel" />
					<Pane HBox.hgrow="ALWAYS" />
					<Text strokeType="OUTSIDE" strokeWidth="0.0"
						styleClass="library-count-badge" text="%libraryRepeatOne" />
				</HBox>
			</VBox>
		</FlowPane>

		<VBox alignment="CENTER" spacing="8.0"
			styleClass="library-empty-state">
			<padding>
				<Insets bottom="18.0" left="16.0" right="16.0" top="18.0" />
			</padding>
			<FontIcon iconLiteral="far-star" iconSize="22"
				styleClass="library-empty-icon" />
			<Text strokeType="OUTSIDE" strokeWidth="0.0"
				styleClass="library-empty-title" text="%libraryFavoritesEmptyTitle" />
			<Text strokeType="OUTSIDE" strokeWidth="0.0"
				styleClass="library-empty-subtitle"
				text="%libraryFavoritesEmptyHint" wrappingWidth="620.0" />
		</VBox>
	</VBox>
</fx:root>
