<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.VBox?>

<?import com.azkar.components.library.ui.toolbar.LibraryHeaderComponent?>
<?import com.azkar.components.library.ui.toolbar.LibraryFilterToolbarComponent?>
<?import com.azkar.components.library.ui.toolbar.LibraryMetaRowComponent?>
<?import com.azkar.components.library.ui.detail.LibraryDetailPaneComponent?>
<?import com.azkar.components.library.ui.browse.LibraryBrowsePaneComponent?>
<fx:root focusTraversable="false" spacing="14.0"
	styleClass="library-root"
	stylesheets="@../../styles/library/library_component_shell.css"
	type="VBox" xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1">
	<padding>
		<Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
	</padding>

	<LibraryHeaderComponent fx:id="headerComponent" />
	<LibraryFilterToolbarComponent
		fx:id="filterToolbarComponent" />
	<LibraryMetaRowComponent
		fx:id="metaRowComponent" />

	<SplitPane dividerPositions="0.73"
		styleClass="library-main-split" VBox.vgrow="ALWAYS">
		<items>
			<LibraryBrowsePaneComponent
				fx:id="browsePaneComponent" VBox.vgrow="ALWAYS" />
			<LibraryDetailPaneComponent
				fx:id="detailPaneComponent" />
		</items>
	</SplitPane>

	<Label fx:id="infoLine" styleClass="library-info-line" />
</fx:root>
