<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<fx:root maxWidth="620.0" minWidth="320.0" prefWidth="548.0"
	spacing="12.0" styleClass="library-card"
	stylesheets="@../../styles/library/remembrance_card_component.css"
	type="VBox" xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1">
	<HBox alignment="CENTER_LEFT" spacing="10.0">
		<Text fx:id="categoryText" strokeType="OUTSIDE" strokeWidth="0.0"
			styleClass="library-card-badge" text="%libraryCategoryUncategorized" />
		<Pane HBox.hgrow="ALWAYS" />
		<HBox alignment="CENTER_RIGHT" spacing="4.0"
			styleClass="library-card-actions">
			<Button mnemonicParsing="false" onAction="#onReadClicked"
				styleClass="library-icon-btn">
				<graphic>
					<FontIcon iconLiteral="fas-book-open" iconSize="12"
						styleClass="library-icon" />
				</graphic>
			</Button>
			<Button mnemonicParsing="false"
				onAction="#onAddToCollectionClicked" styleClass="library-icon-btn">
				<graphic>
					<FontIcon iconLiteral="fas-layer-group" iconSize="12"
						styleClass="library-icon" />
				</graphic>
			</Button>
			<Button fx:id="favoriteButton" mnemonicParsing="false"
				onAction="#onFavoriteClicked" styleClass="library-icon-btn">
				<graphic>
					<FontIcon fx:id="favoriteIcon" iconLiteral="far-star"
						iconSize="12" styleClass="library-icon" />
				</graphic>
			</Button>
		</HBox>
	</HBox>

	<Text fx:id="arabicTextNode" strokeType="OUTSIDE"
		strokeWidth="0.0" styleClass="library-card-ar" wrappingWidth="480.0" />
	<Text fx:id="translationTextNode" strokeType="OUTSIDE"
		strokeWidth="0.0" styleClass="library-card-en" wrappingWidth="480.0" />

	<Separator />

	<HBox alignment="TOP_LEFT" spacing="8.0"
		styleClass="library-card-footer">
		<Label styleClass="library-source-label"
			text="%librarySourceLabel" />
		<Label fx:id="sourceTextNode" maxWidth="1.7976931348623157E308"
			styleClass="library-source-value" wrapText="true" HBox.hgrow="ALWAYS" />
	</HBox>
</fx:root>
