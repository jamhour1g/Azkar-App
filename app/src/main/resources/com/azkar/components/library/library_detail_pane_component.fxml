<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import com.azkar.components.library.ui.detail.LibraryReminderPanelComponent?>
<fx:root minWidth="350.0" spacing="12.0"
	styleClass="library-detail-pane"
	stylesheets="@../../styles/library/library_detail_pane_component.css"
	type="VBox" xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1">
	<Label fx:id="detailCategoryLabel"
		styleClass="library-detail-title" text="%libraryDetailTitle" />
	<Label fx:id="detailArabicLabel" styleClass="library-detail-ar"
		text="%libraryDetailEmpty" wrapText="true" />
	<Label fx:id="detailEnglishLabel" styleClass="library-detail-en"
		wrapText="true" />
	<Separator />
	<Label fx:id="detailSourceLabel"
		styleClass="library-detail-source" text="%librarySourceLabel"
		wrapText="true" />
	<HBox alignment="CENTER_LEFT" spacing="4.0"
		styleClass="library-detail-actions">
		<Button fx:id="detailReadButton" mnemonicParsing="false"
			onAction="#onReadClicked" styleClass="library-icon-btn">
			<graphic>
				<FontIcon iconLiteral="fas-book-open" iconSize="12"
					styleClass="library-icon" />
			</graphic>
		</Button>
		<Button fx:id="detailCollectionButton" mnemonicParsing="false"
			onAction="#onCollectionClicked" styleClass="library-icon-btn">
			<graphic>
				<FontIcon iconLiteral="fas-layer-group" iconSize="12"
					styleClass="library-icon" />
			</graphic>
		</Button>
		<Button fx:id="detailFavoriteButton" mnemonicParsing="false"
			onAction="#onFavoriteClicked" styleClass="library-icon-btn">
			<graphic>
				<FontIcon fx:id="detailFavoriteIcon" iconLiteral="far-star"
					iconSize="12" styleClass="library-icon" />
			</graphic>
		</Button>
	</HBox>
	<LibraryReminderPanelComponent
		fx:id="reminderPanel" />
</fx:root>
