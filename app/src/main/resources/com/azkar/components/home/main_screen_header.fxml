<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<fx:root alignment="CENTER" spacing="20" styleClass="header"
	stylesheets="@../../styles/main_screen_header.css" type="HBox"
	xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
	<FontIcon iconLiteral="fab-ussunnah" iconSize="50"
		styleClass="icon-primary" />
	<VBox>
		<Text strokeType="OUTSIDE" strokeWidth="0.0"
			styleClass="logo-title" text="%azkar">
			<font>
				<Font size="22.0" />
			</font>
		</Text>
		<Text strokeType="OUTSIDE" strokeWidth="0.0"
			styleClass="header-greeting-sub" text="%yourCompanion" />
	</VBox>
	<Pane HBox.hgrow="SOMETIMES" />
	<HBox alignment="CENTER" spacing="15">
		<Button fx:id="homeHeaderBtn" alignment="CENTER"
			mnemonicParsing="false" styleClass="nav-btn" text="%home" />
		<Button fx:id="azkarLibHeaderBtn" alignment="CENTER"
			mnemonicParsing="false" styleClass="nav-btn" text="%azkarLibrary" />
		<Button fx:id="qiblaHeaderBtn" alignment="CENTER"
			mnemonicParsing="false" styleClass="nav-btn" text="Qibla" />
	</HBox>
	<Pane HBox.hgrow="SOMETIMES" />
	<HBox alignment="CENTER" spacing="15">
		<ToggleButton fx:id="darkModeToggle"
			mnemonicParsing="false" styleClass="nav-btn">
			<graphic>
				<FontIcon iconLiteral="far-moon" iconSize="20"
					styleClass="nav-btn" />
			</graphic>
		</ToggleButton>
		<Button fx:id="settingsBtn" alignment="CENTER"
			mnemonicParsing="false" styleClass="nav-btn">
			<graphic>
				<FontIcon iconLiteral="fas-cog" iconSize="20"
					styleClass="nav-btn" />
			</graphic>
		</Button>
		<Region fx:id="avatarRegion" prefHeight="40.0" prefWidth="40.0"
			styleClass="avatar" />
	</HBox>
</fx:root>
