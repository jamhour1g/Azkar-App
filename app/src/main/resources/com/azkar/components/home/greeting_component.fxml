<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<fx:root stylesheets="@../../styles/home/greeting.css"
	alignment="CENTER" spacing="8" styleClass="greeting-container"
	type="VBox" xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1">
	<Text fx:id="greetingTitle" strokeType="OUTSIDE" strokeWidth="0.0"
		styleClass="greeting-title" text="Assalamu Alaikum">
		<font>
			<Font size="48.0" name="Inter Bold" />
		</font>
	</Text>
	<Text fx:id="locationText" strokeType="OUTSIDE" strokeWidth="0.0"
		styleClass="greeting-location"
		text="Prayer times for Ramallah, Palestine" />
	<Text fx:id="dateText" strokeType="OUTSIDE" strokeWidth="0.0"
		styleClass="greeting-date"
		text="14 Dhu al-Hijjah 1445 AH | 20 June 2024" />
</fx:root>
