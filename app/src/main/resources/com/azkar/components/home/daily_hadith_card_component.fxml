<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<fx:root spacing="12.0" styleClass="card-lg"
         stylesheets="@../../styles/home/daily_hadith_card.css" type="VBox"
         xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <Text strokeType="OUTSIDE" strokeWidth="0.0"
          styleClass="section-title" text="%dailyHadith"/>
    <HBox>
        <Separator orientation="VERTICAL"
                   styleClass="hadith-vertical-line" HBox.hgrow="NEVER">
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
            <HBox.margin>
                <Insets right="10.0"/>
            </HBox.margin>
        </Separator>

        <VBox spacing="10" styleClass="hadith-texts" HBox.hgrow="NEVER">
            <Text fx:id="hadithText" strokeType="OUTSIDE"
                  strokeWidth="0.0" styleClass="hadith-ar" text="%hadithExample"
                  wrappingWidth="620.0"/>
            <Text fx:id="hadithExplanation" strokeType="OUTSIDE"
                  strokeWidth="0.0" styleClass="hadith-en" text="%explanationExample"
                  wrappingWidth="620.0"/>
            <Text fx:id="hadithSource" strokeType="OUTSIDE"
                  strokeWidth="0.0" styleClass="hadith-source" text="%sourceExample"
                  wrappingWidth="620.0"/>
            <Button fx:id="readMoreButton" mnemonicParsing="false"
                    styleClass="btn-secondary hadith-read-more-btn" text="%readMore"/>
        </VBox>
    </HBox>
</fx:root>
